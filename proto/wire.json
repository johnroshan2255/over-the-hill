{
  "about": "THE WIRE — every message between the game and the server, in one place: the Rust server (backend/src/wire.rs) and the game (frontend/src/net/wire.ts) both read this file. A frame is binary: [tag u8] then the fields in order. Intents (client → server) start with `req` (varn) after the tag. Poses (tags 1, 2) are packed by hand (proto.rs / net/pose.ts), not here. Types: u8, bool (u8), var (u32 LEB128), varn (null | u32: 0 = null, else v + 1), zz (i32 zigzag LEB128), f32, f32n (f32, NaN = null), u64 (8 B LE), str (var length + UTF-8), strn (null | str: u8 flag + str), an enum (u8 index), a named type, {obj: [[name, type]…]}, {list: type} (var count), {tuple: [type…]}. Tested both sides against backend/tests/golden.json.",
  "enums": {
    "mat": ["wood", "stone", "metal"],
    "store": ["carry", "trailer"],
    "op": ["raise", "lower", "flatten", "smooth"],
    "pave": ["stone", "gravel", "planks", "dirt", "erase"]
  },
  "types": {
    "bag": { "obj": [["wood", "var"], ["stone", "var"], ["metal", "var"]] },
    "player": { "obj": [["sid", "var"], ["id", "str"], ["name", "str"]] },
    "rules": { "obj": [["offline_guard", "bool"], ["regrow_min", "var"], ["refill_min", "var"], ["max_players", "var"], ["claim_min_r", "f32"], ["claim_max_r", "f32"], ["claims_per_player", "var"], ["creative", "bool"]] },
    "world": { "obj": [["id", "str"], ["code", "str"], ["name", "str"], ["map", "str"], ["owner", "str"], ["rules", "rules"]] },
    "claim": { "obj": [["id", "str"], ["owner", "str"], ["owner_name", "str"], ["x", "f32"], ["z", "f32"], ["r", "f32"], ["y", "f32"], ["stock", "bag"], ["created", "u64"]] },
    "piece": { "obj": [["id", "str"], ["kind", "str"], ["owner", "str"], ["claim", "str"], ["x", "f32"], ["y", "f32"], ["z", "f32"], ["rot", "f32"], ["variant", "u8"]] },
    "loose": { "obj": [["id", "str"], ["mat", "mat"], ["qty", "var"], ["x", "f32"], ["y", "f32"], ["z", "f32"], ["claim", "strn"]] },
    "stroke": { "obj": [["mat", "pave"], ["x", "f32"], ["z", "f32"], ["r", "f32"]] },
    "pond": { "obj": [["id", "str"], ["claim", "str"], ["x", "f32"], ["z", "f32"], ["r", "f32"], ["level", "f32"]] },
    "inv": { "obj": [["carry", "bag"], ["trailer", "bag"]] },
    "cell": { "tuple": ["zz", "zz", "zz"] },
    "stump": { "obj": [["tree", "var"], ["x", "f32"], ["z", "f32"]] },
    "node": { "obj": [["key", "str"], ["left", "var"]] },
    "state": { "obj": [
      ["players", { "list": "player" }],
      ["claims", { "list": "claim" }],
      ["guards", { "list": { "tuple": ["str", "bool"] } }],
      ["cells", { "list": { "tuple": ["str", { "list": "cell" }] } }],
      ["paint", { "list": { "tuple": ["str", { "list": "stroke" }] } }],
      ["pieces", { "list": "piece" }],
      ["drops", { "list": "loose" }],
      ["stumps", { "list": "stump" }],
      ["nodes", { "list": "node" }],
      ["ponds", { "list": "pond" }]
    ] }
  },
  "events": {
    "welcome": [30, [["you", "player"], ["world", "world"], ["state", "state"], ["inv", "inv"]]],
    "joined": [31, [["sid", "var"], ["id", "str"], ["name", "str"]]],
    "left": [32, [["sid", "var"]]],
    "chat": [33, [["sid", "var"], ["name", "str"], ["text", "str"]]],
    "tree_cut": [34, [["tree", "var"], ["x", "f32"], ["z", "f32"], ["by", "var"]]],
    "tree_back": [35, [["tree", "var"]]],
    "drop": [36, [["drop", "loose"]]],
    "drop_gone": [37, [["id", "str"]]],
    "node": [38, [["key", "str"], ["left", "var"]]],
    "node_back": [39, [["key", "str"]]],
    "inv": [40, [["inv", "inv"]]],
    "claim": [41, [["claim", "claim"]]],
    "claim_gone": [42, [["id", "str"]]],
    "stock": [43, [["claim", "str"], ["stock", "bag"]]],
    "guard": [44, [["claim", "str"], ["on", "bool"]]],
    "raid": [45, [["claim", "str"], ["owner", "str"], ["by", "var"], ["by_name", "str"], ["bag", "bag"]]],
    "piece": [46, [["piece", "piece"]]],
    "piece_gone": [47, [["id", "str"]]],
    "cells": [48, [["claim", "str"], ["cells", { "list": "cell" }]]],
    "pave": [49, [["claim", "str"], ["stroke", "stroke"]]],
    "pond": [50, [["pond", "pond"]]],
    "pond_gone": [51, [["id", "str"]]],
    "ok": [52, [["req", "var"]]],
    "err": [53, [["req", "varn"], ["msg", "str"]]],
    "pong": [54, [["n", "var"]]],
    "ride": [55, [["sid", "var"], ["car", "str"]]]
  },
  "intents": {
    "chat": [10, [["text", "str"]]],
    "cut_tree": [11, [["tree", "var"], ["x", "f32"], ["z", "f32"], ["h", "f32"]]],
    "mine": [12, [["node", "str"], ["x", "f32"], ["z", "f32"], ["size", "var"]]],
    "pick": [13, [["drop", "str"], ["to", "store"]]],
    "drop": [14, [["mat", "mat"], ["qty", "var"], ["from", "store"], ["x", "f32"], ["y", "f32"], ["z", "f32"]]],
    "deposit": [15, [["claim", "str"], ["from", "store"], ["bag", "bag"]]],
    "take": [16, [["claim", "str"], ["to", "store"], ["bag", "bag"]]],
    "claim": [17, [["x", "f32"], ["z", "f32"], ["r", "f32"]]],
    "unclaim": [18, [["claim", "str"]]],
    "place": [19, [["kind", "str"], ["x", "f32"], ["y", "f32"], ["z", "f32"], ["rot", "f32"], ["variant", "u8"]]],
    "remove": [20, [["piece", "str"]]],
    "shape": [21, [["op", "op"], ["x", "f32"], ["z", "f32"], ["r", "f32"], ["strength", "f32"], ["y", "f32n"]]],
    "pave": [22, [["mat", "pave"], ["x", "f32"], ["z", "f32"], ["r", "f32"]]],
    "pond": [23, [["x", "f32"], ["z", "f32"], ["r", "f32"], ["depth", "f32"]]],
    "ping": [24, [["n", "var"]]], "stow": [25, [["from", "store"], ["to", "store"], ["bag", "bag"]]],
    "ride": [26, [["car", "str"]]]
  }
}
