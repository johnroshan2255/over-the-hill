{
  "name": "overhill-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5200",
    "dev:lan": "LAN=1 vite --host --port 5300",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --port 5200",
    "preview:lan": "LAN=1 vite preview --host --port 5300",
    "test": "npm run test:drivetrain",
    "test:drivetrain": "rolldown tests/drivetrain.test.ts --format esm --platform node --external @dimforge/rapier3d-compat -o node_modules/.cache/tests/drivetrain.test.mjs --log-level warn && node node_modules/.cache/tests/drivetrain.test.mjs",
    "shot": "node scripts/shot.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "naga-wasm": "^30.2.0",
    "playcanvas": "^2.23.3",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "puppeteer-core": "^24.43.1",
    "rolldown": "1.2.11",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
